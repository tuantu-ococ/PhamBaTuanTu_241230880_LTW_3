@model IEnumerable<Sach>
<div class="section-head">
    <h3>@ViewData["TieuDe"]</h3>
    <a href="#">Xem tat ca &rsaquo;</a>
</div>
<div class="grid">
    @foreach ( var item in Model)
    {
        <div class="book-card">
            <a href="#"><img src="~/images/@item.Anh" alt="@item.TenSach" /></a>
            <h2>@item.TenSach</h2>
            <div class="book-foot">
                <span class="price">@(item.Gia?.ToString("0"))</span>
                <button class="btn-buy">Them vao gio</button>
            </div>
        </div>
    }
</div>